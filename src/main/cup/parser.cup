package lyc.compiler;

import java_cup.runtime.*;
import lyc.compiler.symboltable.*;
import java.util.ArrayList;
import lyc.compiler.model.*;
import lyc.compiler.syntactictree.*;
class Parser;

action code {:
public ArrayList<String> var = new ArrayList<>();
SymbolTable sym = SymbolTable.getSymbolTable();
SyntacticTree synt = SyntacticTree.getSyntacticTree();

public static class SemVal {
    public final Nodo node;
    public final String type;

    public SemVal(Nodo node, String type) {
        this.node = node;
        this.type = type;
    }
}

private String typeOfIdentifier(String id) throws VariableNotDeclaredException {
    if (!sym.exists(id)) {
        throw new VariableNotDeclaredException("La variable \"" + id + "\" no fue declarada.");
    }
    return sym.get(id).getType();
}

private boolean isNumeric(String type) {
    return "INT".equals(type) || "FLOAT".equals(type);
}

private String numericResult(String left, String right) {
    if ("FLOAT".equals(left) || "FLOAT".equals(right)) {
        return "FLOAT";
    }
    return "INT";
}

private void requireNumeric(String op, String type) throws InvalidOperandException {
    if (!isNumeric(type)) {
        throw new InvalidOperandException("Operador " + op + " requiere operandos numericos. Tipo encontrado: " + type);
    }
}

private void requireInt(String op, String type) throws InvalidOperandException {
    if (!"INT".equals(type)) {
        throw new InvalidOperandException("Operador " + op + " requiere operando INT. Tipo encontrado: " + type);
    }
}

private void requireComparable(String op, String left, String right) throws InvalidOperandException {
    if (isNumeric(left) && isNumeric(right)) {
        return;
    }
    if ("STRING".equals(left) && "STRING".equals(right)) {
        return;
    }
    throw new InvalidOperandException("Tipos incompatibles para operador " + op + ": " + left + " y " + right);
}

private void requireAssignable(String targetType, String valueType, String id) throws TypeMismatchException {
    if (targetType.equals(valueType)) {
        return;
    }
    if ("FLOAT".equals(targetType) && "INT".equals(valueType)) {
        return;
    }
    throw new TypeMismatchException("No se puede asignar " + valueType + " a " + targetType + " en \"" + id + "\"");
}

private String mergeListType(String left, String right) throws InvalidOperandException {
    if (isNumeric(left) && isNumeric(right)) {
        return numericResult(left, right);
    }
    if ("STRING".equals(left) && "STRING".equals(right)) {
        return "STRING";
    }
    throw new InvalidOperandException("Tipos incompatibles en lista: " + left + " y " + right);
}

private int countList(Nodo n) {
    if (n == null) return 0;

    if (n instanceof Leaf) return 1;

    Root r = (Root) n;

    if (r.getOperador().equals("LIST_VALUE")) {
        return countList(r.getIzq()) + countList(r.getDer());
    }

    // un solo elemento
    return 1;
}

private void requireInType(String elementType, String listType) throws InvalidOperandException {
    if ("STRING".equals(listType)) {
        if (!"STRING".equals(elementType)) {
            throw new InvalidOperandException("IN requiere STRING, encontrado: " + elementType);
        }
        return;
    }
    if ("FLOAT".equals(listType)) {
        if (!isNumeric(elementType)) {
            throw new InvalidOperandException("IN requiere numerico, encontrado: " + elementType);
        }
        return;
    }
    if ("INT".equals(listType)) {
        if (!"INT".equals(elementType)) {
            throw new InvalidOperandException("IN requiere INT, encontrado: " + elementType);
        }
        return;
    }
    throw new InvalidOperandException("Tipo de lista invalido para IN: " + listType);
}
:};

// Terminals
terminal ASSIG;
terminal PLUS;
terminal SUB;
terminal MULT;
terminal DIV;
terminal OPEN_BRACKET;
terminal CLOSE_BRACKET;
terminal OPEN_SQUARE_BRACKET;
terminal CLOSE_SQUARE_BRACKET;
terminal INTEGER_CONSTANT;
terminal IDENTIFIER;
terminal OPEN_CURLY_BRACKET;
terminal CLOSE_CURLY_BRACKET;
terminal FLOAT_CONSTANT;
terminal STRING_CONSTANT;
terminal COLON;
terminal COMMA;
terminal AND;
terminal OR;
terminal NOT;
terminal READ;
terminal IF;
terminal ELSE;
terminal GREATER_THAN;
terminal GREATER_THAN_OR_EQUAL;
terminal LESS_THAN;
terminal LESS_THAN_OR_EQUAL;
terminal EQUAL;
terminal NOT_EQUAL;
terminal FOR;
terminal TO;
terminal DO;
terminal IN;
terminal MOD;
terminal LONG;

terminal WHILE;
terminal WRITE;
terminal INIT;
terminal INT;
terminal STRING;
terminal FLOAT;
terminal STEP;
terminal NEXT;

// Non Terminals
non terminal Nodo program;
non terminal Nodo block;
non terminal Nodo sentence;
non terminal Nodo assignment;
non terminal SemVal expression;
non terminal SemVal term;
non terminal SemVal factor;
non terminal Nodo init_sentence;
non terminal Nodo init_line;
non terminal Nodo var_list;
non terminal Nodo var_type;
non terminal Nodo write_sentence;
non terminal Nodo write_line;
non terminal Nodo read_sentence;
non terminal Nodo read_line;
non terminal Nodo if_sentence;
non terminal Nodo else_sentence;
non terminal Nodo while_sentence;
non terminal Nodo while_line;
non terminal Nodo for_sentence;
non terminal SemVal condition_sentence;
non terminal SemVal list_values;
non terminal SemVal opt_step;

// Start Symbol Definition
start with program;

program ::= block:b {:
	RESULT = b;
	synt.setRoot(b);
:};

// Agrupo sentencias en bloques y aplico recursividad para soportar multiples lineas.
block ::= block:b sentence:s {:
	RESULT = new Root("BLOCK", b, s);
:};
block ::= sentence:s {:
	RESULT = new Root("BLOCK", s, null);
:};

// Write
sentence ::= write_sentence:w_s {:
	System.out.println("WRITE");
	RESULT = w_s;
:};

write_sentence ::= WRITE OPEN_BRACKET write_line:w_l CLOSE_BRACKET {:
	System.out.println("Bloque WRITE");
	RESULT = new Root("WRITE", w_l, null);
:};

write_line ::= IDENTIFIER:id {:
	System.out.println("Write: " + id);
	typeOfIdentifier(id.toString());
	RESULT = new Leaf(id.toString());
:};

write_line ::= STRING_CONSTANT:constant {:
    System.out.println("Write: " + constant);
    String c = constant.toString();
    sym.insert(c,"STRING",c,false);
    RESULT = new Leaf(c);
:};

// Read
sentence ::= read_sentence:r_s {:
	System.out.println("READ");
	RESULT = r_s;
:};

read_sentence ::= READ OPEN_BRACKET read_line:r_l CLOSE_BRACKET {:
	System.out.println("Bloque READ");
	RESULT = new Root("READ", r_l, null);
:};

read_line ::= IDENTIFIER:id {:
	System.out.println("Read: " + id);
	typeOfIdentifier(id.toString());
	RESULT = new Leaf(id.toString());
:};

// Assignments
sentence ::= assignment:a {:
	System.out.println("End");
	RESULT = a;
:};

assignment ::= IDENTIFIER:id ASSIG expression:e {:
	System.out.println("Assignment "+id+":= expression");
	String targetType = typeOfIdentifier(id.toString());
	requireAssignable(targetType, e.type, id.toString());
	RESULT = new Root("ASSIG", new Leaf(id.toString()), e.node);
:};


// Init
sentence ::= init_sentence:i_s {:
	System.out.println("INIT");
		RESULT = i_s;
:};

init_sentence ::= INIT OPEN_CURLY_BRACKET init_line:i_l CLOSE_CURLY_BRACKET {:
	System.out.println("Bloque INIT");
	RESULT = new Root("INIT_BLOCK", i_l, null);
:};

init_line ::=  var_list:v_l COLON var_type:v_t init_line:i_l {:
	System.out.println("Linea declaracion de variables INIT");
	Nodo declaracion = new Root("INIT_LINE", v_t, v_l);
	RESULT = new Root("INIT", declaracion, i_l );
:};


init_line ::=  var_list COLON var_type:v_t {:
	System.out.println("Ultima Linea declaracion de variables INIT");
	RESULT = v_t;
:};

var_list ::= IDENTIFIER:id COMMA var_list {:
    var.add(id.toString());
    System.out.println("Variable: "+id);
:};

var_list ::= IDENTIFIER:id {:
    var.add(id.toString());
    System.out.println("Variable: "+id);
:};

var_type ::= STRING {: System.out.println("STRING");
	Nodo ultimo = null;
    for (String v: var){
        if(sym.exists(v)){
            throw new VariableAlreadyDeclaredException("La variable \""+v+"\" Ya fue declarada.");
        }
        sym.insert(v,"STRING","",true);
        ultimo = new Root("STRING", new Leaf(v), ultimo);
    }
    RESULT = ultimo;
    var.clear();
:};

var_type ::= INT {: System.out.println("INT");
    Nodo ultimo = null;
    for (String v: var){
        if(sym.exists(v)){
            throw new VariableAlreadyDeclaredException("La variable \""+v+"\" Ya fue declarada.");
        }
        sym.insert(v,"INT","",true);
        ultimo = new Root("INT", new Leaf(v), ultimo);
    }
    RESULT = ultimo;
    var.clear();
:};

var_type ::= FLOAT {: System.out.println("FLOAT");
	Nodo ultimo = null;
    for (String v: var){
        if(sym.exists(v)){
            throw new VariableAlreadyDeclaredException("La variable \""+v+"\" Ya fue declarada.");
        }
        sym.insert(v,"FLOAT","",true);
        ultimo = new Root("FLOAT", new Leaf(v), ultimo);

    }
    RESULT = ultimo;
    var.clear();
:};

// Conditions
condition_sentence ::= expression:e1 AND expression:e2 {:
	System.out.println("AND");
	requireInt("AND", e1.type);
	requireInt("AND", e2.type);
	RESULT = new SemVal(new Root("AND", e1.node, e2.node), "INT");
:};

condition_sentence ::= expression:e1 OR expression:e2 {:
	System.out.println("OR");
	requireInt("OR", e1.type);
	requireInt("OR", e2.type);
	RESULT = new SemVal(new Root("OR", e1.node, e2.node), "INT");
:};

condition_sentence ::= NOT expression:e {:
	System.out.println("NOT");
	requireInt("NOT", e.type);
	RESULT = new SemVal(new Root("NOT", e.node, null), "INT");
:};

condition_sentence ::= expression:e IN OPEN_SQUARE_BRACKET list_values:l_v CLOSE_SQUARE_BRACKET {:
	System.out.println("IN");
	requireInType(e.type, l_v.type);
	RESULT = new SemVal(new Root("IN", e.node, l_v.node), "INT");
:};

condition_sentence ::= expression:e {:
	System.out.println("Condition");
	requireNumeric("COND", e.type);
	RESULT = new SemVal(e.node, "INT");
:};

list_values ::= expression:e COMMA list_values:l_v {:
	System.out.println("List value");
	String listType = mergeListType(e.type, l_v.type);
	RESULT = new SemVal(new Root("LIST_VALUE", e.node, l_v.node), listType);
:};

list_values ::= expression:e {:
	System.out.println("Last list value");
	RESULT = new SemVal(e.node, e.type);
:};

// If/else condition
sentence ::= if_sentence:if_s {:
	System.out.println("IF");
	RESULT = if_s;
:};

if_sentence ::= IF OPEN_BRACKET condition_sentence:c_s CLOSE_BRACKET OPEN_CURLY_BRACKET block:b CLOSE_CURLY_BRACKET {:
	System.out.println("If sentence");
	RESULT = new Root("IF", c_s.node, b);
:};

if_sentence ::= IF OPEN_BRACKET condition_sentence:c_s CLOSE_BRACKET OPEN_CURLY_BRACKET block:b CLOSE_CURLY_BRACKET else_sentence:e_s {:
	System.out.println("If with else sentence");
	Nodo body_if = new Root("BODY_IF", b, e_s);
	RESULT = new Root("IF_ELSE", c_s.node, body_if);
:};
else_sentence ::= ELSE OPEN_CURLY_BRACKET block:b CLOSE_CURLY_BRACKET {:
	System.out.println("Else sentence");
	RESULT = b;
:};

// While
sentence ::= while_sentence:w_s {:
	System.out.println("While");
	RESULT = w_s;
:};
while_sentence ::= WHILE OPEN_BRACKET condition_sentence:c_s CLOSE_BRACKET while_line:w_l {:
	System.out.println("While sentence");
	RESULT = new Root ("WHILE", c_s.node, w_l);
:};


while_sentence ::= WHILE OPEN_BRACKET condition_sentence:c_s CLOSE_BRACKET DO while_line:w_l {:
	System.out.println("While-do sentence");
	RESULT = new Root ("WHILE-DO", w_l, c_s.node);
:};
while_line ::= OPEN_CURLY_BRACKET block:b CLOSE_CURLY_BRACKET {:
	System.out.println("While line");
	RESULT = b;
:};

// For
sentence ::= for_sentence:f_s {:
	System.out.println("FOR");
	RESULT = f_s;
:};
for_sentence ::= FOR OPEN_BRACKET IDENTIFIER:id ASSIG expression:from TO expression:to CLOSE_BRACKET opt_step:o_s OPEN_CURLY_BRACKET block:b CLOSE_CURLY_BRACKET NEXT IDENTIFIER:next_id {:
	System.out.println("For sentence");
	String varType = typeOfIdentifier(id.toString());
	requireNumeric("FOR", varType);
	requireAssignable(varType, from.type, id.toString());
	requireAssignable(varType, to.type, id.toString());
	if (o_s != null) {
		requireAssignable(varType, o_s.type, id.toString());
	}

	Nodo var_inic_for = new Leaf(id.toString());
	Nodo range_for = new Root("range_for", from.node, to.node);
	Nodo data_for = new Root("data_for", b, o_s == null ? null : o_s.node);
	RESULT = new Root("FOR", var_inic_for, new Root("FOR_BODY", range_for, data_for));
:};
opt_step ::= STEP expression:e {:
	RESULT = e;
:};
opt_step ::= {:
	RESULT = null;
:};

// Expressions
expression ::= expression:e PLUS term:t {:
	System.out.println("+");
	requireNumeric("+", e.type);
	requireNumeric("+", t.type);
	RESULT = new SemVal(new Root("+", e.node, t.node), numericResult(e.type, t.type));
:};

expression ::= expression:e SUB term:t {:
	System.out.println("-");
	requireNumeric("-", e.type);
	requireNumeric("-", t.type);
	RESULT = new SemVal(new Root("-", e.node, t.node), numericResult(e.type, t.type));
:};


expression ::= expression:e GREATER_THAN term:t {:
	System.out.println(">");
	requireComparable(">", e.type, t.type);
	RESULT = new SemVal(new Root(">", e.node, t.node), "INT");
:};

expression ::= expression:e GREATER_THAN_OR_EQUAL term:t {:
	System.out.println(">=");
	requireComparable(">=", e.type, t.type);
	RESULT = new SemVal(new Root(">=", e.node, t.node), "INT");
:};

expression ::= expression:e LESS_THAN term:t {:
	System.out.println("<");
	requireComparable("<", e.type, t.type);
	RESULT = new SemVal(new Root("<", e.node, t.node), "INT");
:};

expression ::= expression:e LESS_THAN_OR_EQUAL term:t {:
	System.out.println("<=");
	requireComparable("<=", e.type, t.type);
	RESULT = new SemVal(new Root("<=", e.node, t.node), "INT");
:};

expression ::= expression:e NOT_EQUAL term:t {:
	System.out.println("!=");
	requireComparable("!=", e.type, t.type);
	RESULT = new SemVal(new Root("!=", e.node, t.node), "INT");
:};

expression ::= expression:e EQUAL term:t {:
	System.out.println("==");
	requireComparable("==", e.type, t.type);
	RESULT = new SemVal(new Root("==", e.node, t.node), "INT");
:};
expression ::= term:t {:
	System.out.println("Expression = Term");
	RESULT = t;
:};
term ::= term:t MULT factor:f {:
	System.out.println("*");
	requireNumeric("*", t.type);
	requireNumeric("*", f.type);
	RESULT = new SemVal(new Root("*", t.node, f.node), numericResult(t.type, f.type));
:};
term ::= term:t DIV factor:f {:
	System.out.println("/");
	requireNumeric("/", t.type);
	requireNumeric("/", f.type);
	RESULT = new SemVal(new Root("/", t.node, f.node), numericResult(t.type, f.type));
:};
term ::= term:t MOD factor:f {:
	System.out.println("%");
	requireInt("%", t.type);
	requireInt("%", f.type);
	RESULT = new SemVal(new Root("%", t.node, f.node), "INT");
:};

term ::= factor:f {:
	System.out.println("Term = factor");
	RESULT = f;
:};

factor ::= IDENTIFIER:id  {:
	System.out.println("Id: " + id);
	String type = typeOfIdentifier(id.toString());
	RESULT = new SemVal(new Leaf(id.toString()), type);
:};

factor ::= FLOAT_CONSTANT:constant {:
    System.out.println("FLOAT Constant: " + constant );
    sym.insert(constant.toString(),"FLOAT",constant.toString(),false);
	RESULT = new SemVal(new Leaf(constant.toString()), "FLOAT");
:};
factor ::= INTEGER_CONSTANT:constant {:
    System.out.println("INT Constant: " + constant );
    sym.insert(constant.toString(),"INT",constant.toString(),false);
	RESULT = new SemVal(new Leaf(constant.toString()), "INT");
:};

factor ::= STRING_CONSTANT:constant {:
    System.out.println("STRING Constant: " + constant );
    String c = constant.toString();
    sym.insert(c,"STRING",c,false);
    RESULT = new SemVal(new Leaf(c), "STRING");
:};

factor ::= OPEN_BRACKET expression:e CLOSE_BRACKET {:
	System.out.println("Factor = (Expression)");
	RESULT = e;
:};

// Long
factor ::= LONG OPEN_BRACKET OPEN_SQUARE_BRACKET list_values:l_v CLOSE_SQUARE_BRACKET CLOSE_BRACKET {:
    System.out.println("Long function");
	int size = countList(l_v.node);
	RESULT = new SemVal(new Leaf(String.valueOf(size)), "INT");
:};
